  "glossary": [
    {
      "term": "复数",
      "def": "形如 $x+iy$ 的数，也是复平面上的点/向量。",
      "chapterId": "ch01"
    },
    {
      "term": "模与辐角",
      "def": "复数到原点的距离 $r$，以及与正实轴的夹角 $\\theta$；$z=re^{i\\theta}$。",
      "chapterId": "ch01"
    },
    {
      "term": "共轭复数",
      "def": "$z=x+iy$ 的共轭是 $\\bar z=x-iy$，且 $z\\bar z=\\lvert z\\rvert^2$。",
      "chapterId": "ch01"
    },
    {
      "term": "复变函数",
      "def": "定义域和值域都在复平面上的函数 $w=f(z)$。",
      "chapterId": "ch01"
    },
    {
      "term": "支点",
      "def": "绕一圈后函数值不复原的点，如 $\\sqrt z$、$\\ln z$ 的 $0$ 与 $\\infty$。",
      "chapterId": "ch01"
    },
    {
      "term": "分支切割",
      "def": "从支点引出的割线，切开平面后才能选出单值分支。",
      "chapterId": "ch01"
    },
    {
      "term": "解析函数",
      "def": "在一点的邻域内处处可导的函数；解析比可导要求更强。",
      "chapterId": "ch02"
    },
    {
      "term": "柯西–黎曼方程",
      "def": "$u_x=v_y$、$u_y=-v_x$，复可导的充要条件之一。",
      "chapterId": "ch02"
    },
    {
      "term": "调和函数",
      "def": "满足 $\\Delta u=0$ 的函数；解析函数的实部与虚部都是。",
      "chapterId": "ch02"
    },
    {
      "term": "保角映射",
      "def": "导数非零的解析映射，局部保持角度大小与方向。",
      "chapterId": "ch02"
    },
    {
      "term": "柯西积分定理",
      "def": "单连通区域内解析函数的闭路积分为零。",
      "chapterId": "ch03"
    },
    {
      "term": "柯西积分公式",
      "def": "$f(z_0)=\\frac{1}{2\\pi i}\\oint_C\\frac{f(z)}{z-z_0}dz$。",
      "chapterId": "ch03"
    },
    {
      "term": "刘维尔定理",
      "def": "全平面解析且有界的函数必为常数。",
      "chapterId": "ch03"
    },
    {
      "term": "最大模原理",
      "def": "非常数解析函数的模最大值只能在边界取到。",
      "chapterId": "ch03"
    },
    {
      "term": "泰勒级数",
      "def": "解析点附近的幂级数，收敛半径到最近奇点。",
      "chapterId": "ch04"
    },
    {
      "term": "洛朗级数",
      "def": "环形区域内允许负幂项的展开。",
      "chapterId": "ch04"
    },
    {
      "term": "孤立奇点",
      "def": "$f$ 在 $z_0$ 附近解析但 $z_0$ 本身不解析；分可去、极点、本性。",
      "chapterId": "ch04"
    },
    {
      "term": "留数",
      "def": "洛朗展开中 $\\frac{1}{z-z_0}$ 项的系数 $a_{-1}$。",
      "chapterId": "ch04"
    },
    {
      "term": "留数定理",
      "def": "闭路积分等于 $2\\pi i$ 乘围道内留数之和。",
      "chapterId": "ch04"
    },
    {
      "term": "辐角原理",
      "def": "$\\frac{1}{2\\pi i}\\oint\\frac{f'}{f}dz$ 等于零点数减极点数。",
      "chapterId": "ch04"
    },
    {
      "term": "傅里叶级数",
      "def": "周期函数展开成三角函数的级数。",
      "chapterId": "ch05"
    },
    {
      "term": "傅里叶变换",
      "def": "$F(k)=\\int f(x)e^{-ikx}dx$，把空间描述换成频率描述。",
      "chapterId": "ch05"
    },
    {
      "term": "卷积",
      "def": "$(f*g)(x)=\\int f(\\xi)g(x-\\xi)d\\xi$；频域里是乘法。",
      "chapterId": "ch05"
    },
    {
      "term": "δ函数",
      "def": "单位脉冲，$\\int\\delta(x)\\phi(x)dx=\\phi(0)$。",
      "chapterId": "ch05"
    },
    {
      "term": "拉普拉斯变换",
      "def": "$F(s)=\\int_0^{\\infty}f(t)e^{-st}dt$，用于初值问题。",
      "chapterId": "ch06"
    },
    {
      "term": "收敛域",
      "def": "拉普拉斯积分收敛的 $s$ 范围，通常是右半平面。",
      "chapterId": "ch06"
    },
    {
      "term": "传递函数",
      "def": "零初值下输出与输入在 $s$ 域的比值。",
      "chapterId": "ch06"
    },
    {
      "term": "波动方程",
      "def": "$u_{tt}=a^2\\Delta u$，双曲型，需要两个初始条件。",
      "chapterId": "ch07"
    },
    {
      "term": "热传导方程",
      "def": "$u_t=a^2\\Delta u$，抛物型，只需一个初始条件。",
      "chapterId": "ch07"
    },
    {
      "term": "拉普拉斯方程",
      "def": "$\\Delta u=0$，椭圆型，描述稳态场。",
      "chapterId": "ch07"
    },
    {
      "term": "泊松方程",
      "def": "$\\Delta u=-f$，有源的稳态方程。",
      "chapterId": "ch07"
    },
    {
      "term": "Dirichlet 边界",
      "def": "给定边界上的函数值 $u=g$。",
      "chapterId": "ch07"
    },
    {
      "term": "Neumann 边界",
      "def": "给定边界上的法向导数 $\\partial_nu=g$。",
      "chapterId": "ch07"
    },
    {
      "term": "Robin 边界",
      "def": "函数值与法向导数的线性组合给定。",
      "chapterId": "ch07"
    },
    {
      "term": "定解条件",
      "def": "初始条件与边界条件的统称。",
      "chapterId": "ch07"
    },
    {
      "term": "适定性",
      "def": "解存在、唯一、且连续依赖数据。",
      "chapterId": "ch07"
    },
    {
      "term": "分离变量",
      "def": "设乘积解把偏微分方程拆成常微分方程。",
      "chapterId": "ch08"
    },
    {
      "term": "本征值问题",
      "def": "$X''+\\lambda X=0$ 加齐次边界，只有离散的 $\\lambda$ 有非零解。",
      "chapterId": "ch08"
    },
    {
      "term": "本征函数",
      "def": "对应本征值的非零解 $X_n$，构成展开基。",
      "chapterId": "ch08"
    },
    {
      "term": "正交性",
      "def": "不同本征值的本征函数内积为零。",
      "chapterId": "ch08"
    },
    {
      "term": "完备性",
      "def": "任意满足边界条件的函数都能按本征函数展开。",
      "chapterId": "ch08"
    },
    {
      "term": "冲量定理",
      "def": "受迫系统的解等于源与自由响应的卷积，也叫杜哈梅原理。",
      "chapterId": "ch08"
    },
    {
      "term": "达朗贝尔公式",
      "def": "一维波动方程用初始位移与速度写出的显式解。",
      "chapterId": "ch09"
    },
    {
      "term": "特征线",
      "def": "波动方程中 $x\\pm at=$ 常数的曲线，信息沿它传播。",
      "chapterId": "ch09"
    },
    {
      "term": "依赖区域",
      "def": "影响某点取值的初始数据区间 $[x-at,x+at]$。",
      "chapterId": "ch09"
    },
    {
      "term": "延拓法",
      "def": "把半无界初始数据按奇偶对称延到全轴，用全无界公式求解。",
      "chapterId": "ch09"
    },
    {
      "term": "格林函数",
      "def": "点源引起的场，满足 $LG=\\delta$ 与齐次边界。",
      "chapterId": "ch10"
    },
    {
      "term": "基本解",
      "def": "自由空间中点源的响应，不含边界修正。",
      "chapterId": "ch10"
    },
    {
      "term": "镜像法",
      "def": "在区域外放虚拟源，使边界条件自动满足。",
      "chapterId": "ch10"
    },
    {
      "term": "推迟势",
      "def": "源在 $t-r/a$ 时刻的作用在 $t$ 时刻到达场点。",
      "chapterId": "ch10"
    },
    {
      "term": "勒让德多项式",
      "def": "球坐标极角方程的有界多项式解 $P_l$。",
      "chapterId": "ch11"
    },
    {
      "term": "母函数",
      "def": "$\\frac{1}{\\sqrt{1-2xt+t^2}}=\\sum P_l(x)t^l$。",
      "chapterId": "ch11"
    },
    {
      "term": "罗德里格斯公式",
      "def": "$P_l=\\frac{1}{2^ll!}\\frac{d^l}{dx^l}(x^2-1)^l$。",
      "chapterId": "ch11"
    },
    {
      "term": "连带勒让德函数",
      "def": "$P_l^m$，含 $m\\ne0$ 的极角解。",
      "chapterId": "ch11"
    },
    {
      "term": "球谐函数",
      "def": "球面上的正交归一基 $Y_{lm}$。",
      "chapterId": "ch11"
    },
    {
      "term": "贝塞尔函数",
      "def": "柱坐标径向方程的解 $J_\\nu$、$Y_\\nu$。",
      "chapterId": "ch12"
    },
    {
      "term": "修正贝塞尔函数",
      "def": "$I_\\nu$、$K_\\nu$，描述指数增长与衰减。",
      "chapterId": "ch12"
    },
    {
      "term": "球贝塞尔函数",
      "def": "$j_l$、$n_l$，可用正弦余弦除以 $x$ 表示。",
      "chapterId": "ch12"
    },
    {
      "term": "泛函",
      "def": "输入为函数、输出为数的映射。",
      "chapterId": "ch13"
    },
    {
      "term": "变分",
      "def": "函数发生小扰动时泛函的一阶改变量 $\\delta J$。",
